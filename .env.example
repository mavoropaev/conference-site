# Шаблон переменных окружения. Скопируйте в .env и замените значения.
# Реальные секреты в репозиторий не попадают (.env в .gitignore).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=conference
POSTGRES_USER=conference
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
